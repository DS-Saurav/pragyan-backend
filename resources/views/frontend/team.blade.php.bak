            @foreach ($order as $key => $title)
                @php $people = $groups[$key] ?? collect(); @endphp
                @if ($people->isNotEmpty())
                    <section data-group="{{ $key }}">
                        <h2>{{ $title }}</h2>
                        <div class="grid">
                            @foreach ($people as $p)
                                <article class="card"
                                    data-search="{{ strtolower($p->name . ' ' . $p->designation) }}"
                                    data-person="{{ json_encode(['name' => $p->name, 'role' => $p->designation, 'qual' => $p->qualification, 'bio' => $p->bio, 'photo' => $p->photoUrl(), 'initials' => $p->initials()]) }}">
                                    <div class="photo">
                                        @if ($p->photoUrl())
                                            <img src="{{ $p->photoUrl() }}" alt="{{ $p->name }}" loading="lazy">
                                        @else
                                            {{ $p->initials() }}
                                        @endif
                                    </div>
                                    <h3>{{ $p->name }}</h3>
                                    @if ($p->designation)
                                        <p class="role">{{ $p->designation }}</p>
                                    @endif
                                    @if ($p->qualification)
                                        <p class="qual">{{ $p->qualification }}</p>
                                    @endif
                                </article>
                            @endforeach
                        </div>
                    </section>
                @endif
            @endforeach

            <p class="none" id="none">No one matches your search.</p>
        @endif
