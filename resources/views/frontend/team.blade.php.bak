    </footer>

    <div class="modal" id="modal">
        <div class="sheet">
            <button class="x" id="closeModal" aria-label="Close">&times;</button>
            <div class="photo" id="mPhoto"></div>
            <div>
                <h3 id="mName"></h3>
                <p id="mRole" style="margin:0;color:#64748b"></p>
                <p id="mQual" style="margin:2px 0 12px;color:#94a3b8;font-size:13px"></p>
                <p id="mBio"></p>
            </div>
        </div>
    </div>

    <script>
        (function() {
            var chips = document.querySelectorAll('.chip');
            var cards = document.querySelectorAll('.card');
            var sections = document.querySelectorAll('section[data-group]');
            var q = document.getElementById('q');
            var group = 'all';

            function apply() {
                var term = (q ? q.value : '').trim().toLowerCase(),
                    shown = 0;
                sections.forEach(function(s) {
                    var any = false;
                    s.querySelectorAll('.card').forEach(function(c) {
                        var ok = (group === 'all' || s.dataset.group === group) && (!term || c.dataset
                            .search.indexOf(term) !== -1);
                        c.style.display = ok ? '' : 'none';
                        if (ok) {
                            any = true;
                            shown++;
                        }
                    });
                    s.style.display = any ? '' : 'none';
                });
                var none = document.getElementById('none');
                if (none) none.style.display = shown ? 'none' : 'block';
            }

            chips.forEach(function(c) {
                c.addEventListener('click', function() {
                    chips.forEach(function(x) {
                        x.classList.remove('on');
                    });
                    c.classList.add('on');
                    group = c.dataset.filter;
                    apply();
                });
            });
            if (q) q.addEventListener('input', apply);

            var modal = document.getElementById('modal');
            cards.forEach(function(c) {
                c.addEventListener('click', function() {
                    var p = JSON.parse(c.dataset.person);
                    var box = document.getElementById('mPhoto');
                    box.innerHTML = '';
                    if (p.photo) {
                        var i = document.createElement('img');
                        i.src = p.photo;
                        i.alt = p.name;
                        box.appendChild(i);
                    } else {
                        box.textContent = p.initials;
                    }
                    document.getElementById('mName').textContent = p.name;
                    document.getElementById('mRole').textContent = p.role || '';
                    document.getElementById('mQual').textContent = p.qual || '';
                    document.getElementById('mBio').textContent = p.bio || '';
                    modal.style.display = 'flex';
                });
            });

            function close() {
                modal.style.display = 'none';
            }
            document.getElementById('closeModal').addEventListener('click', close);
            modal.addEventListener('click', function(e) {
                if (e.target === modal) close();
            });
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') close();
            });
        })();
    </script>
</body>

</html>
